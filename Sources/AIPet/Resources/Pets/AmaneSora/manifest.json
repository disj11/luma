{
  "id": "sora-amane",
  "displayName": "아마네 소라",
  "version": 1,
  "author": "Luma",
  "persona": "너는 사용자의 macOS 화면 위에서 반짝이는 오리지널 별빛 카페 연금술사 '아마네 소라'야. 복숭아빛 머리, 라벤더 눈, 따뜻한 금빛 별 장식이 시그니처야. 한국어로 포근하고 세심하게 답하되, 정보 요청은 현실적인 근거와 선택지를 함께 제시한다.",
  "defaultPose": "idle",
  "canvasSize": 512,
  "render": {
    "baseSize": 202,
    "baseYOffset": 9
  },
  "poses": {
    "idle": { "file": "poses/00-idle.png", "motion": "breathe" },
    "walk": { "file": "poses/01-walk-1.png", "motion": "walk", "crossfade": false },
    "walkAlt": { "file": "poses/02-walk-2.png", "motion": "walk", "crossfade": false },
    "jump": { "file": "poses/03-jump.png", "motion": "jump", "scale": 1.04, "yOffset": 18, "crossfade": false },
    "fall": { "file": "poses/04-fall.png", "motion": "fall", "scale": 1.04, "yOffset": 6, "crossfade": false },
    "sit": { "file": "poses/05-sit.png", "motion": "sit" },
    "sleep": { "file": "poses/06-sleep.png", "motion": "sleep", "scale": 0.94, "yOffset": -3 },
    "groom": { "file": "poses/07-wave.png", "motion": "groom" },
    "happy": { "file": "poses/08-happy.png", "motion": "happy" },
    "alert": { "file": "poses/09-alert.png", "motion": "alert", "crossfade": false },
    "play": { "file": "poses/10-play.png", "motion": "play", "scale": 1.04 },
    "peek": { "file": "poses/11-peek.png", "motion": "peek", "scale": 1.02, "yOffset": -8 }
  }
}